# Environment
.env
*.env
# Pins, not secrets: tracked, so every check sees them.
!scripts/tools.env

# Visual Studio Code
.vscode


# Rust
target/

# TypeScript
node_modules/
dist/
coverage/
*.tsbuildinfo
# Playwright's run output (the committed screenshots live in services/web/test/screenshots/).
test-results/
playwright-report/

# Go
services/runner/bin/
# `go build ./services/runner` from the root.
/runner

# Editors and OS
.idea/
.DS_Store
*.swp

# The pinned versions of the dev environment are not secrets (RAN-16).
!deployments/dev/versions.env
