# go install, with the go.mod toolchain; the Go checksum database verifies every module.
GOVULNCHECK=1.9.0
# cargo install --locked; crates.io's index checksums verify every crate. Matches sqlx in Cargo.toml.
SQLX_CLI=0.9.0
# The Rust tests' OIDC provider (scripts/test/services.sh). Dex publishes no binaries: its source archive is
# checked against this sha256, then built with its own go.sum. The same version as the chart's Dex image.
DEX=2.46.1
DEX_SHA256=05e2e149b53f9876269362fefa9061b4b1abd3d5437f23247d79e44a77ac487d

