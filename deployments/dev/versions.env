# Every external version the dev environment uses (RAN-16). Sourced by scripts/cluster.sh.
# Images are pinned by tag AND digest (the digest of the multi-arch index). Never `latest`.
# To bump: skopeo inspect --raw docker://<image>:<tag> | sha256sum

# Oldest Kubernetes the preflight accepts (major.minor).
KUBERNETES_MIN=1.32

# The preflight's probe pods (runs as a non-root user, has sh and curl).
CURL_IMAGE=docker.io/curlimages/curl:8.23.0@sha256:3fb7e13e5d179a845c97d78204f3f1064d1907037f26a3ebf91710571151fd93

# The smoke test's clients: psql (the chart's Postgres image) and the nats CLI.
PSQL_IMAGE=ghcr.io/cloudnative-pg/postgresql:18.6-minimal-trixie@sha256:26d15a12723510b0b416e8aec2bc65f2da7ac9b77ef3182a0911e4b8b991420a
NATS_BOX_IMAGE=docker.io/natsio/nats-box:0.20.2@sha256:5162fca0f56ebe6f78e612e1ded143ce978e088393476033020e6251358dba6f

# The git mirror (RAN-17), built on main by .github/workflows/images.yaml. There is no image to pin
# until its first run, and `up` refuses this placeholder until it is replaced by tag@digest.
GIT_MIRROR_IMAGE=ghcr.io/rangelight/git-mirror:d24f24f962b1488c02e70ae2eb81262590737b8a@sha256:d1e0d4b88e52a10d03a352e0e203194268735e9833f4f0bff92d6e1acaa11c36

# The runner and the lane agent (RAN-19, RAN-21), built on main by .github/workflows/images.yaml, the same way.
RUNNER_IMAGE=ghcr.io/rangelight/runner:d24f24f962b1488c02e70ae2eb81262590737b8a@sha256:dd4afc7dfe9bf6aeb19c605911e8d93d223dd709eb962684d313b2cf8492f8d3
AGENT_IMAGE=ghcr.io/rangelight/agent:d24f24f962b1488c02e70ae2eb81262590737b8a@sha256:7d419c5960b5b91a741376480e86655230b5e7ec913253eb5d968ac71bb8d0ca

# The api, the relay and the Workbench (RAN-44), built on main by .github/workflows/images.yaml; `up` refuses UNPINNED
# until they are pinned, as above.
API_IMAGE=ghcr.io/rangelight/api:d24f24f962b1488c02e70ae2eb81262590737b8a@sha256:b507734a172ded4df2902b31c82fa9e1b52ffcee9584fd2eb516edc88172f0b2
RELAY_IMAGE=ghcr.io/rangelight/relay:d24f24f962b1488c02e70ae2eb81262590737b8a@sha256:4b5b19b3fc1f457f513324d5d8bb98b0e1245dd5cf18493f1233d866fdfcd76f
WEB_IMAGE=ghcr.io/rangelight/web:d24f24f962b1488c02e70ae2eb81262590737b8a@sha256:b9eefd64ba0857a9514ba576549f881630b4ad6f1628492859d0d74a98c2c561
