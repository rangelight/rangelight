# Every external version the dev environment uses (RAN-16). Sourced by script/cluster.sh.
# Images are pinned by tag AND digest (the digest of the multi-arch index). Never `latest`.
# To bump: skopeo inspect --raw docker://<image>:<tag> | sha256sum

# Oldest Kubernetes the preflight accepts (major.minor).
KUBERNETES_MIN=1.32

# Zot, the OCI registry (ADR 0040 §5).
ZOT_IMAGE=ghcr.io/project-zot/zot:v2.1.23@sha256:9d3de83ac2099e6f4843045b4c9b65b7e8baf40f92d28f54906dee9d4d390fd7

# The preflight's probe pods (runs as a non-root user, has sh and curl).
CURL_IMAGE=docker.io/curlimages/curl:8.23.0@sha256:3fb7e13e5d179a845c97d78204f3f1064d1907037f26a3ebf91710571151fd93
