#!/usr/bin/env bash
# Tells Rangelight what a session's push stored (ADR 0010, 0011), one JSON object per POST:
# - each new checkpoint (refs/rangelight/sessions/<id>/cp/<n>) to RANGELIGHT_EVENTS_URL;
# - each update of its work branch (refs/heads/rangelight/<id>/work) to RANGELIGHT_PUSHED_URL, the
#   runner, which publishes it upstream. The POST carries the pushing session's own Authorization
#   header, which the runner checks the way it checks /auth/git; nothing else vouches for it.
# An unset URL sends nothing. The push is already stored, so a failed POST only warns.
set -euo pipefail
export LC_ALL=C

# shellcheck source=services/git-mirror/identity.sh
source "$(dirname "${BASH_SOURCE[0]}")/../identity.sh"
events="${RANGELIGHT_EVENTS_URL-}" pushed="${RANGELIGHT_PUSHED_URL-}"
[[ -n "${events}${pushed}" ]] || exit 0
rl_identity && [[ "${RL_ROLE}" == session ]] || exit 0

# The header nginx's auth_request already accepted: a Basic or Bearer token, nothing to quote.
auth="${HTTP_AUTHORIZATION-}"
[[ "${auth}" =~ ^(Basic|Bearer)\ [A-Za-z0-9+/=._-]+$ ]] || pushed=""

while IFS=' ' read -r old new ref; do
  # Object ids only, and not a deletion (all zeros).
  [[ "${old}${new}" =~ ^[0-9a-f]{80,128}$ && "${new}" == *[1-9a-f]* ]] || continue
  if [[ -n "${events}" && "${ref}" =~ ^refs/rangelight/sessions/${RL_SESSION}/cp/([1-9][0-9]{0,8})$ ]]; then
    n="${BASH_REMATCH[1]}"
    printf '{"session":"%s","checkpoint":%s,"commit":"%s","previous":"%s"}' "${RL_SESSION}" "${n}" "${new}" "${old}" |
      curl -fsS --max-time 5 -H 'Content-Type: application/json' --data-binary @- -o /dev/null "${events}" ||
      printf 'rangelight: checkpoint %s stored, but not reported\n' "${ref}" >&2
  elif [[ -n "${pushed}" && "${ref}" == "refs/heads/rangelight/${RL_SESSION}/work" ]]; then
    # The token goes in through curl's config on stdin, never its argv.
    printf 'header = "Authorization: %s"\n' "${auth}" |
      curl -fsS --max-time 5 -K - -H 'Content-Type: application/json' -o /dev/null "${pushed}" \
        --data-binary "$(printf '{"session":"%s","ref":"%s","commit":"%s"}' "${RL_SESSION}" "${ref}" "${new}")" ||
      printf 'rangelight: %s stored, but not published yet\n' "${ref}" >&2
  fi
done
