{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["publicUrl", "clusterDns", "oidc", "dex", "postgres", "nats", "gitMirror", "runner", "api"],
  "properties": {
    "global": { "description": "Helm's values shared with the subcharts.", "type": "object" },
    "publicUrl": { "description": "Where browsers reach Rangelight: https://<host>[:<port>], without a path.", "$ref": "#/$defs/publicUrl" },
    "clusterDns": {
      "description": "The cluster DNS pods: the only DNS server of the lanes and of Dex.",
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "podLabel"],
      "properties": {
        "namespace": { "$ref": "#/$defs/dnsName" },
        "podLabel": {
          "description": "One label that selects them, as key=value.",
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?=[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$"
        }
      }
    },
    "oidc": {
      "description": "The api's OIDC client: at bundled Dex, or at your own provider when dex.enabled is false.",
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "clientId", "memberClaim", "clientSecretRef"],
      "properties": {
        "issuer": { "description": "Your provider's issuer, when dex.enabled is false.", "anyOf": [{ "const": "" }, { "$ref": "#/$defs/httpsUrl" }] },
        "clientId": { "description": "The api's client id at the issuer.", "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
        "memberClaim": { "description": "The ID-token claim that names the member.", "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
        "clientSecretRef": {
          "description": "The Secret in rangelight-system, and its key, holding the api's client secret.",
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": { "name": { "$ref": "#/$defs/dnsName" }, "key": { "$ref": "#/$defs/secretKey" } }
        }
      }
    },
    "dex": {
      "description": "enabled and github are Rangelight's; every other key goes to the upstream dex chart.",
      "type": "object",
      "required": [
        "enabled", "github", "ingressFrom", "clusterCidrs", "fullnameOverride", "replicaCount", "image", "configSecret",
        "serviceAccount", "envVars", "resources", "networkPolicy"
      ],
      "properties": {
        "enabled": { "description": "Install Dex, or use your own provider (oidc.issuer).", "type": "boolean" },
        "github": {
          "type": "object",
          "additionalProperties": false,
          "required": ["org"],
          "properties": {
            "org": { "description": "The GitHub organisation whose members may sign in.", "anyOf": [{ "const": "" }, { "$ref": "#/$defs/githubOrg" }] }
          }
        },
        "ingressFrom": {
          "description": "Who may reach Dex besides the api: namespace labels and pod labels.",
          "type": "object",
          "additionalProperties": false,
          "required": ["namespaceLabels", "podLabels"],
          "properties": { "namespaceLabels": { "$ref": "#/$defs/labels" }, "podLabels": { "$ref": "#/$defs/labels" } }
        },
        "clusterCidrs": {
          "description": "The cluster's pod and service CIDRs, which Dex's HTTPS egress excludes.",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$" }
        },
        "networkPolicy": {
          "description": "The upstream chart's policy: off, ours (templates/dex/networkpolicy.yaml) replaces it.",
          "type": "object",
          "required": ["enabled"],
          "properties": { "enabled": { "const": false } }
        },
        "fullnameOverride": { "const": "rangelight-dex" },
        "replicaCount": { "description": "One server: its storage is in memory.", "const": 1 },
        "image": {
          "type": "object",
          "required": ["repository", "digest"],
          "properties": {
            "repository": { "description": "The image and its tag.", "type": "string", "pattern": "^[a-z0-9.-]+(/[a-z0-9._-]+)+:[A-Za-z0-9._-]+$", "not": { "pattern": ":latest$" } },
            "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        },
        "configSecret": {
          "description": "The config is templates/dex/config.yaml.",
          "type": "object",
          "required": ["create", "name"],
          "properties": { "create": { "const": false }, "name": { "const": "rangelight-dex-config" } }
        },
        "config": { "description": "Unused: the config is templates/dex/config.yaml.", "type": "object", "maxProperties": 0 },
        "serviceAccount": {
          "type": "object",
          "required": ["create", "name"],
          "properties": { "create": { "const": false }, "name": { "const": "rangelight-dex" } }
        },
        "envVars": {
          "description": "The credentials, each from a Secret, never a value.",
          "type": "array",
          "items": { "type": "object", "required": ["name", "valueFrom"], "not": { "required": ["value"] } }
        },
        "resources": { "$ref": "#/$defs/resources" }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "storage", "resources", "external"],
      "properties": {
        "enabled": { "description": "Install CloudNativePG and the cluster rangelight-pg, or use postgres.external.", "type": "boolean" },
        "image": { "description": "The Postgres image, by tag and digest.", "$ref": "#/$defs/pinnedImage" },
        "storage": { "description": "Size of the data volume.", "$ref": "#/$defs/storage" },
        "resources": { "$ref": "#/$defs/resources" },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "required": ["secretRef"],
          "properties": {
            "secretRef": {
              "description": "The Secret in rangelight-system, and its key, holding the api's Postgres connection URI.",
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "key"],
              "properties": {
                "name": { "anyOf": [{ "const": "" }, { "$ref": "#/$defs/dnsName" }] },
                "key": { "type": "string", "pattern": "^[-._a-zA-Z0-9]{1,253}$" }
              }
            }
          }
        }
      },
      "if": { "properties": { "enabled": { "const": false } } },
      "then": { "properties": { "external": { "properties": { "secretRef": { "properties": { "name": { "$ref": "#/$defs/dnsName" } } } } } } }
    },
    "nats": {
      "description": "enabled and external are Rangelight's; every other key goes to the upstream nats chart.",
      "type": "object",
      "required": ["enabled", "external", "fullnameOverride"],
      "properties": {
        "enabled": { "description": "Install a NATS server with JetStream, or use nats.external.", "type": "boolean" },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": {
            "url": { "description": "The NATS URL the api connects to.", "anyOf": [{ "const": "" }, { "$ref": "#/$defs/natsUrl" }] }
          }
        },
        "fullnameOverride": { "description": "The server's name, and its Service's.", "$ref": "#/$defs/dnsName" },
        "config": {
          "type": "object",
          "properties": {
            "jetstream": {
              "type": "object",
              "properties": {
                "enabled": { "const": true },
                "fileStore": {
                  "type": "object",
                  "properties": {
                    "pvc": { "type": "object", "properties": { "size": { "$ref": "#/$defs/storage" } } }
                  }
                }
              }
            }
          }
        },
        "container": {
          "type": "object",
          "properties": {
            "image": { "type": "object", "properties": { "fullImageName": { "$ref": "#/$defs/pinnedImage" } } },
            "resources": { "$ref": "#/$defs/resources" }
          }
        }
      },
      "if": { "properties": { "enabled": { "const": false } } },
      "then": { "properties": { "external": { "properties": { "url": { "$ref": "#/$defs/natsUrl" } } } } }
    },
    "cloudnative-pg": { "description": "The upstream cloudnative-pg chart's values; its own schema checks them.", "type": "object" },
    "gitMirror": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "repos", "syncIntervalSeconds", "storage"],
      "properties": {
        "enabled": { "description": "Run the git mirror.", "type": "boolean" },
        "image": { "description": "The git mirror image, by tag and digest.", "anyOf": [{ "const": "" }, { "$ref": "#/$defs/pinnedImage" }] },
        "repos": {
          "description": "The repos to mirror: each served at /<name>.git, fetched from its public https upstream.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "upstream"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$", "not": { "pattern": "\\.git$" } },
              "upstream": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~-]+)+$" }
            }
          }
        },
        "syncIntervalSeconds": { "description": "Seconds between upstream fetches.", "type": "integer", "minimum": 60 },
        "storage": { "description": "Size of the mirror's volume.", "$ref": "#/$defs/storage" }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": { "properties": { "image": { "$ref": "#/$defs/pinnedImage" }, "repos": { "minItems": 1 } } }
    },
    "api": {
      "description": "Where the api's sessions work, and for whom (configs/api.default.toml).",
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "baseRef", "member", "streamReplicas"],
      "properties": {
        "repo": {
          "description": "The git mirror's repo name, without .git. Required at render.",
          "anyOf": [{ "const": "" }, { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$", "not": { "pattern": "\\.git$" } }]
        },
        "baseRef": {
          "description": "A branch name.",
          "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
          "not": { "pattern": "(\\.\\.|//|/$|\\.lock$)" }
        },
        "member": { "description": "A DNS label. Required at render.", "anyOf": [{ "const": "" }, { "$ref": "#/$defs/dnsName" }] },
        "streamReplicas": { "description": "1 to 5.", "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "namespace", "image", "agentImage", "workers", "tmpSize", "resources"],
      "properties": {
        "enabled": { "description": "Run the runner.", "type": "boolean" },
        "namespace": { "description": "The runner's own namespace, never rangelight-system.", "$ref": "#/$defs/dnsName" },
        "image": { "description": "The runner image, by tag and digest.", "anyOf": [{ "const": "" }, { "$ref": "#/$defs/pinnedImage" }] },
        "agentImage": { "description": "The lane agent image, by tag and digest.", "anyOf": [{ "const": "" }, { "$ref": "#/$defs/pinnedImage" }] },
        "workers": { "description": "How many Sessions reconcile at once.", "type": "integer", "minimum": 1, "maximum": 64 },
        "tmpSize": { "description": "The runner's /tmp, for the profile reads' shallow clones.", "$ref": "#/$defs/storage" },
        "resources": { "$ref": "#/$defs/resources" }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": { "properties": { "image": { "$ref": "#/$defs/pinnedImage" }, "agentImage": { "$ref": "#/$defs/pinnedImage" } } }
    }
  },
  "if": { "properties": { "dex": { "properties": { "enabled": { "const": true } } } } },
  "then": {
    "description": "Bundled Dex needs the GitHub organisation, and reads the api's client secret from rangelight-oidc.",
    "properties": {
      "dex": { "properties": { "github": { "properties": { "org": { "$ref": "#/$defs/githubOrg" } } } } },
      "oidc": {
        "properties": {
          "memberClaim": { "const": "preferred_username" },
          "clientSecretRef": { "properties": { "name": { "const": "rangelight-oidc" }, "key": { "const": "client-secret" } } }
        }
      }
    }
  },
  "else": { "properties": { "oidc": { "properties": { "issuer": { "$ref": "#/$defs/httpsUrl" } } } } },
  "$defs": {
    "dnsName": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$" },
    "secretKey": { "type": "string", "pattern": "^[-._a-zA-Z0-9]{1,253}$" },
    "labels": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": { "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$" },
      "additionalProperties": { "type": "string", "pattern": "^([A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?)?$" }
    },
    "githubOrg": { "type": "string", "pattern": "^[A-Za-z0-9](-?[A-Za-z0-9]){0,38}$" },
    "publicUrl": { "type": "string", "pattern": "^https://[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*(:[0-9]{1,5})?$" },
    "httpsUrl": { "type": "string", "pattern": "^https://[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*(:[0-9]{1,5})?(/[-._~A-Za-z0-9]+)*$" },
    "natsUrl": { "type": "string", "pattern": "^(nats|tls)://[-.a-zA-Z0-9]+(:[0-9]{1,5})?$" },
    "pinnedImage": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+(:[0-9]+)?(/[a-z0-9._-]+)+:[A-Za-z0-9._-]+@sha256:[0-9a-f]{64}$",
      "not": { "pattern": ":latest@" }
    },
    "storage": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$" },
    "quantity": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(m|Mi|Gi)?$" },
    "resources": {
      "description": "The pod's resources: CPU and memory requests, and a memory limit.",
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory"],
          "properties": { "cpu": { "$ref": "#/$defs/quantity" }, "memory": { "$ref": "#/$defs/quantity" } }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["memory"],
          "properties": { "cpu": { "$ref": "#/$defs/quantity" }, "memory": { "$ref": "#/$defs/quantity" } }
        }
      }
    }
  }
}
