# Every tool the checks run, pinned once (RAN-42): read by scripts/check.sh, scripts/tools.sh and,
# through tools.sh, CI. Nothing else names a version. Plain sourceable shell.
# NAME=version; NAME_SHA256_<os>_<arch>= the sha256 of that release archive, checked before it is unpacked.
# To bump a release tool: set the version and copy the new sha256 from the release's own checksum file.
# Go toolchain: go.mod. Rust: rust-toolchain.toml. Node: .nvmrc. pnpm: packageManager in package.json.
# scripts/check.sh checks those four too.

# The tools scripts/tools.sh installs, in this order: uv before the Python tools it installs.
TOOLS="gitleaks buf shellcheck helm kubeconform golangci-lint govulncheck cargo-nextest cargo-deny cargo-machete
sqlx-cli nats-server postgresql dex uv yamllint check-jsonschema"

# --- release archives ----------------------------------------------------------------------------

GITLEAKS=8.30.1
